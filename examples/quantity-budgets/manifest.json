{
  "version": 2,
  "agent": "batch-assistant",
  "limits": {
    "depth": 4,
    "quantities": {
      "exported_records": {"amount": "1000", "unit": "record"},
      "generated_tokens": {"amount": "20000", "unit": "token"}
    }
  },
  "tools": [
    {"name": "open_batch", "effect": "read", "produces": "batch", "unbounded": true},
    {
      "name": "export_records", "effect": "irreversible", "requires_approval": true,
      "requires": ["batch"], "scope_key": "batch", "value_arg": "records",
      "quantity": "exported_records", "ceiling": {"amount": "800", "unit": "record"}
    },
    {
      "name": "generate_text", "effect": "read", "requires": ["batch"],
      "scope_key": "batch", "value_arg": "tokens", "quantity": "generated_tokens",
      "ceiling": {"amount": "12000", "unit": "token"}
    }
  ]
}
