permit (
  principal is AgentCore::IamEntity,
  action == AgentCore::Action::"BindingLatencyTarget___process_refund",
  resource == AgentCore::Gateway::"<reviewed-gateway-binding>"
);

forbid (
  principal is AgentCore::IamEntity,
  action == AgentCore::Action::"BindingLatencyTarget___process_refund",
  resource == AgentCore::Gateway::"<reviewed-gateway-binding>"
) when temporal {
  exists (total: Long).
    (sum amt for (amt: Long), (t: Timepoint). where
      (formerly within 1h
        (AgentCore::Action::"BindingLatencyTarget___process_refund"::request{
          eventResource: resource,
          input.amount: amt
        } && tp(t)))) == total && total >= 1000
};
