forbid (
  principal is AgentCore::IamEntity,
  action == AgentCore::Action::"BoundaryTarget___process_refund",
  resource is AgentCore::Gateway
)
when temporal {
  exists (total: Long).
    (sum amt for (amt: Long), (t: Timepoint).
      where (formerly within 1h (AgentCore::Action::"BoundaryTarget___process_refund"::request{
        input.amount: amt
      } && tp(t)))) == total
    && total >= 1000
};
