{
  "tools": [
    {
      "description": "Run a SQL query against PostgreSQL",
      "inputSchema": {
        "$defs": {
          "ConnectionMethod": {
            "description": "Connection method enumeration.",
            "enum": [
              "rdsapi",
              "pgwire",
              "pgwire_iam"
            ],
            "title": "ConnectionMethod",
            "type": "string"
          }
        },
        "properties": {
          "cluster_identifier": {
            "description": "Cluster identifier",
            "title": "Cluster Identifier",
            "type": "string"
          },
          "connection_method": {
            "$ref": "#/$defs/ConnectionMethod",
            "description": "connection method"
          },
          "database": {
            "description": "database name",
            "title": "Database",
            "type": "string"
          },
          "db_endpoint": {
            "description": "database endpoint",
            "title": "Db Endpoint",
            "type": "string"
          },
          "query_parameters": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Parameters for the SQL query",
            "title": "Query Parameters"
          },
          "sql": {
            "description": "The SQL query to run",
            "title": "Sql",
            "type": "string"
          }
        },
        "required": [
          "sql",
          "connection_method",
          "cluster_identifier",
          "db_endpoint",
          "database"
        ],
        "title": "run_queryArguments",
        "type": "object"
      },
      "name": "run_query",
      "outputSchema": {
        "properties": {
          "result": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Result",
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "title": "run_queryOutput",
        "type": "object"
      }
    },
